# Entorno virtual — se recrea con requirements-dev.txt, nunca se versiona
.venv/
venv/
env/

# Bytecode y cachés de Python
__pycache__/
*.py[cod]
*$py.class

# Tests y cobertura
.pytest_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml

# Empaquetado
build/
dist/
*.egg-info/

# Editores / IDE
.vscode/
.idea/
*.swp

# Sistema operativo
Thumbs.db
desktop.ini
.DS_Store

# Ficheros que escribe el taxímetro al usarse (Fase 2): tarifas, histórico y logs.
# Se versiona solo config/tarifas.example.json, que documenta el formato.
# config/credenciales.json (Fase 3) sí se versiona: solo lleva sal y hash.
config/tarifas.json
data/
logs/
